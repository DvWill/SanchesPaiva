{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.js": {
      "includeFiles": "{admin/**,assets/**,database/schema.sql,*.html,*.css,*.js}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/privacidade", "destination": "/privacidade.html" },
    { "source": "/admin/demandas", "destination": "/server.js" },
    { "source": "/admin/demandas/(.*)", "destination": "/server.js" },
    { "source": "/admin/demandas.html", "destination": "/server.js" },
    { "source": "/admin/demanda.html", "destination": "/server.js" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/noticias/nova", "destination": "/server.js" },
    { "source": "/admin/noticias/(.*)/editar", "destination": "/server.js" },
    { "source": "/admin/editor.html", "destination": "/server.js" },
    { "source": "/admin/index.html", "destination": "/server.js" },
    { "source": "/admin", "destination": "/server.js" },
    { "source": "/blog/(.*)", "destination": "/post.html" },
    { "source": "/blog", "destination": "/blog.html" }
  ]
}
